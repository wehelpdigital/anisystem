            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "/images/pwa/icon-maskable-512.png?v=anee",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "shortcuts": [
