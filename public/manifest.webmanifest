{
    "name": "anee.io Smart Farm App",
    "short_name": "anee.io",
    "description": "Plan a season, run the day, and keep the record \u2014 for farms and the people who work them.",
    "id": "/app",
    "start_url": "/launch.html",
    "scope": "/",
    "display": "standalone",
