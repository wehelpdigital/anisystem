APP_NAME=anee.io
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://anisystem.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Shared btc-check MySQL database (both apps use the same DB)
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@anisystem.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Mother system (btc-check) integration ---
BTC_CHECK_URL=http://btc-check.test
BTC_CHECK_PUBLIC_PATH="C:/xampp/htdocs/btc-check/public"
ANISYSTEM_STORE_ID=5
ANISYSTEM_STORE_NAME=AniSystem
ANISYSTEM_ORDER_USERS_ID=1
GOOGLE_MAPS_KEY=

# The mother app that stores uploaded media. Without these the app keeps
# writing to its own disk, which does not survive a deploy.
MOTHER_APP_URL=https://dragonscale-axis-production.up.railway.app
ANISYSTEM_MEDIA_TOKEN=

# Resend (https://resend.com) — the app's mail transport.
# RESEND_FROM must be an address on a domain verified in Resend. The
# sandbox sender onboarding@resend.dev only delivers to the account
# owner's own address, which is fine for testing and nothing else.
RESEND_KEY=""
RESEND_FROM="AniSystem <onboarding@resend.dev>"
