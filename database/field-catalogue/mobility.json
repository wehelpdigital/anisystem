{
 "v": 1,
 "classes": {
  "systemic": {
   "en": "Systemic",
   "say": "Taken in and carried through the plant, so it reaches parts the spray did not touch, and new growth."
  },
  "translaminar": {
   "en": "Translaminar",
   "say": "Soaks through the leaf from the sprayed side to the other side, but does not travel through the whole plant."
  },
  "contact": {
   "en": "Contact",
   "say": "Stays where it lands. It works only on what the spray touches, so cover the plant well."
  }
 },
 "herb": {
  "selective": {
   "en": "Selective",
   "say": "Kills certain weeds and spares the crop it is labelled for."
  },
  "non_selective": {
   "en": "Non selective",
   "say": "Kills any green plant it touches, the crop too. Keep it off the crop."
  },
  "pre": {
   "en": "Pre",
   "say": "Pre emergence: goes on before the weeds come up, on moist soil."
  },
  "early_post": {
   "en": "Early post",
   "say": "Early post emergence: on young weeds with a few leaves."
  },
  "post": {
   "en": "Post",
   "say": "Post emergence: on weeds already up and growing."
  },
  "burndown": {
   "en": "Burndown",
   "say": "Clears every weed before planting."
  }
 },
